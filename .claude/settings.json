{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev-setup.sh\" --phase session --if-remote",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
